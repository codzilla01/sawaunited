# Sawa United — إعدادات Apache لاستضافة Hostinger المشتركة
# ملاحظة: لا تضع أي بيانات سرية في هذا الملف.

Options -Indexes
DirectoryIndex index.html index.php

# ---------- 1) HTTPS + الدومين الموحّد ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # فرض HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # توحيد الدومين بدون www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # منع الوصول لمجلدات التطوير
  RewriteRule ^(docs|scripts|dist|backups|api/data)(/|$) - [R=404,L]
</IfModule>

# ---------- 1b) مركز القيادة /super-admin ----------
# الرابط يعمل مباشرة كـ /super-admin/ بفضل DirectoryIndex، مع رؤوس منع الفهرسة
# والمعرّفة داخل super-admin/.htaccess. لا تُضف إعادة توجيه هنا حتى لا يتعطل
# الدخول من لوحة Hostinger.
<IfModule mod_rewrite.c>
  RewriteRule ^super-admin/?$ super-admin/index.html [L]
</IfModule>

# ---------- 2) حماية الأسرار ----------
# config.php يحتوي كلمة سر قاعدة البيانات: لا يُقرأ من المتصفح أبدًا.
<FilesMatch "^(config\.php|config\.sample\.php|\.env|\.htaccess|composer\.(json|lock)|package(-lock)?\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# منع أي وصول لملفات مخفية أو ملفات نسخ احتياطية
<FilesMatch "(^\.|~$|\.(bak|old|orig|save|swp|sql|zip|tar|gz)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---------- 3) رؤوس أمان ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # فعّل السطر التالي بعد التأكد من أن HTTPS يعمل على كل الصفحات
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

</IfModule>

# ---------- 4) الضغط ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ---------- 5) التخزين المؤقت ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 2 days"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Serve a branded not-found page for missing routes.
ErrorDocument 404 /404.html
